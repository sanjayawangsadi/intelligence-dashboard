# PostgreSQL connection settings.
# Copy to .env and fill in real values. .env is git-ignored.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=intelligence_dashboard
DB_USER=postgres
DB_PASSWORD=postgres

# Optional: full DSN overrides the individual DB_* values above.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/intelligence_dashboard

# Optional: logging.
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
